// Certified build properties for PropImitationHooks. The Updater
// (Play Integrity) installs newer builds of this same package from
// update.jcao.dev, so keep the package name and bump versionCode.
runtime_resource_overlay {
    name: "CertifiedPropsDiting",
    certificate: "platform",
    product_specific: true,
}
