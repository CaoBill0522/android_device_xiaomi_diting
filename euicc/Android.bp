android_app {
    name: "DitingEuicc",
    srcs: ["src/**/*.java"],
    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    required: ["privapp_whitelist_org.diting.euicc.xml"],
}

prebuilt_etc {
    name: "privapp_whitelist_org.diting.euicc.xml",
    src: "privapp_whitelist_org.diting.euicc.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
