android_app {
    name: "DitingEsim",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    static_libs: ["extphonelib"],
    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    required: [
        "openeuicc_component_overrides.xml",
        "privapp_whitelist_org.diting.esim.xml",
    ],
}

prebuilt_etc {
    name: "openeuicc_component_overrides.xml",
    src: "openeuicc_component_overrides.xml",
    sub_dir: "sysconfig",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "privapp_whitelist_org.diting.esim.xml",
    src: "privapp_whitelist_org.diting.esim.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
