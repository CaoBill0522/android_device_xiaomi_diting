<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="android.overlay.diting.euicc">
    <!-- Only the ditingp board (22081212UG) has an eUICC, behind physical slot 1. It is only
         there while eSIM is switched on (otherwise slot 1 is the SIM2 tray), so DitingEsim
         enables this overlay together with the switch. On diting boards (K50 Ultra,
         22081212G) slot 1 is always a regular SIM slot. -->
    <overlay android:targetPackage="android"
                   android:priority="710"
                   android:requiredSystemPropertyName="ro.boot.product.hardware.sku"
                   android:requiredSystemPropertyValue="ditingp"/>
</manifest>
